.build/
*.app
.DS_Store

# Xcode's per-user state, written whenever the package is opened in the IDE.
.swiftpm/
*.xcuserstate
xcuserdata/

# Session memory kept by a Claude Code plugin: notes about working on the project,
# not part of it.
.memsearch/

__pycache__/

# Release packages, built by Scripts/package-release.sh.
dist/

# Claude Code's own files - notes, skills, settings, and the plans and specs it writes
# while working - and the design canvases the screens were drawn on. Kept on disk;
# what came of them is the app itself.
.claude/
docs/superpowers/
design/
